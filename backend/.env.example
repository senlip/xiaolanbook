# 小蓝书后端配置示例 — 复制为 .env 后修改

# 数据库（默认 SQLite 零配置；切 PostgreSQL：postgresql+psycopg://user:pwd@host:5432/db）
DATABASE_URL=sqlite:///./xiaolanbook.db

# JWT 签名密钥（生产环境请用 openssl rand -hex 32 生成）
SECRET_KEY=dev-secret-change-me-please-32bytes-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS（Flutter 调试 + 本机浏览器）
CORS_ORIGINS=*

# 短信验证码占位（真生产用阿里云/腾讯云 SMS）
SMS_DEV_CODE=123456